# =====================================================
# Retail Analytics MCP - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=geo_retail_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL (Chat History)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=geo_retail_chat
POSTGRES_USER=geocom
POSTGRES_PASSWORD=g3oc@m*2026

# Ollama (Development LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Grok xAI (Development LLM - Free tier)
# Get API key from https://console.x.ai
XAI_API_KEY=

# Anthropic Claude (Production LLM)
# Get API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
MCP_SERVER_PORT=8081

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Logging
LOG_LEVEL=INFO
