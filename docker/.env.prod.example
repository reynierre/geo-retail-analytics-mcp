# =====================================================
# Production Environment Variables
# Copy to .env.prod and configure with real values
# =====================================================

# ClickHouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password

# PostgreSQL
POSTGRES_USER=geocom
POSTGRES_PASSWORD=your_secure_postgres_password

# Kafka
KAFKA_HOST=your-kafka-host.com

# Superset (Apache 2.0 - Commercial friendly)
SUPERSET_SECRET_KEY=your_very_long_random_secret_key_min_42_chars
SUPERSET_DB_PASSWORD=your_secure_superset_db_password
SUPERSET_ADMIN_PASSWORD=your_secure_superset_admin_password

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# LLM Provider (prod uses Ollama local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude (alternative for high-quality responses)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Grok xAI (for development/testing)
XAI_API_KEY=your_xai_api_key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO

# Security
JWT_SECRET=your_jwt_secret_key_min_32_chars
